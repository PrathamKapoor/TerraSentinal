# ==============================================================================
# TerraSentinel Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# Project & Debug Mode
PROJECT_NAME=TerraSentinel
DEBUG=True

# Database Configuration (Defaults to SQLite; supports PostgreSQL/PostGIS)
DATABASE_URL=sqlite:///backend/terrasentinel.db
# DATABASE_URL=postgresql://user:password@localhost:5432/terrasentinel

# Optional STAC / Cloud Credentials (leave empty for fixture/offline mode)
# PC_SDK_SUBSCRIPTION_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-west-2

# External STAC API Endpoints
EARTH_SEARCH_STAC_URL=https://earth-search.aws.element84.com/v1
PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Calibration & Sensor Thresholds (Decibels & Slope Degrees)
SAR_VV_WATER_THRESHOLD_DB=-16.0
SAR_VH_WATER_THRESHOLD_DB=-23.0
OPTICAL_MNDWI_WATER_THRESHOLD=0.0
DEM_MAX_WATER_SLOPE_DEG=8.0

# Road & Bridge Inundation Passability Thresholds
PASSABILITY_PARTIAL_THRESHOLD=0.10
PASSABILITY_LIKELY_BLOCKED_THRESHOLD=0.35
PASSABILITY_BLOCKED_THRESHOLD=0.60

# Evidence Fusion & Conflict Thresholds
EVIDENCE_CONFLICT_THRESHOLD=0.40
ALLOW_FIXTURE_FALLBACK=True
